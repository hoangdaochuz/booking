POSTGRES_PASSWORD=ticketbox_secret
JWT_SECRET=your-jwt-secret-change-in-production
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092

# Service configuration
SERVICE_NAME=gateway
DATABASE_URL=postgres://ticketbox:ticketbox_secret@postgres-user:5432/ticketbox_user?sslmode=disable
USER_SERVICE_ADDR=user-service:50051
EVENT_SERVICE_ADDR=event-service:50052
BOOKING_SERVICE_ADDR=booking-service:50053
PAYMENT_SERVICE_ADDR=payment-service:50054
SAGA_SERVICE_ADDR=saga-service:50055

# Stripe (set these for payment integration)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_SECRET_WEBHOOK=

# Optional overrides (defaults exist in code)
GRPC_PORT=50051
HTTP_PORT=8000
BOOKING_MODE=pessimistic
JWT_ACCESS_TOKEN_TTL=15
JWT_REFRESH_TOKEN_TTL=7
